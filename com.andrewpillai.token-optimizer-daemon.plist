<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andrewpillai.token-optimizer-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/appi/my-claude-plugins/token-optimizer-daemon.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/appi/.claude/logs/token-optimizer-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/appi/.claude/logs/token-optimizer-daemon.error.log</string>
    <key>WorkingDirectory</key>
    <string>/Users/appi/my-claude-plugins</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Users/appi/homebrew/bin</string>
    </dict>
</dict>
</plist>
